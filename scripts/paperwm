    ["drift-left"]="['<Control><Super>bracketleft']"
    ["drift-right"]="['<Control><Super>bracketright']"
    ["live-alt-tab"]="['<Alt>Tab']"
    ["live-alt-tab-backward"]="['']"
    ["live-alt-tab-scratch"]="['']"
    ["live-alt-tab-scratch-backward"]="['']"
    ["move-down"]="['<Control><Super>j']"
    ["move-down-workspace"]="['']"
    ["move-left"]="['<Control><Super>h']"
    ["move-monitor-above"]="['']"
    ["move-monitor-below"]="['']"
    ["move-monitor-left"]="['']"
    ["move-monitor-right"]="['']"
    ["move-previous-workspace"]="['']"
    ["move-previous-workspace-backward"]="['']"
    ["move-right"]="['<Control><Super>l']"
    ["move-space-monitor-above"]="['']"
    ["move-space-monitor-below"]="['']"
    ["move-space-monitor-left"]="['']"
    ["move-space-monitor-right"]="['']"
    ["move-up"]="['<Control><Super>k']"
    ["move-up-workspace"]="['']"
    ["new-window"]="['']"
    ["open-window-position-down"]="[]"
    ["open-window-position-end"]="[]"
    ["open-window-position-left"]="[]"
    ["open-window-position-right"]="[]"
    ["open-window-position-start"]="[]"
    ["open-window-position-up"]="[]"
    ["paper-toggle-fullscreen"]="['']"
    ["previous-workspace"]="['']"
    ["previous-workspace-backward"]="['']"
    ["resize-h-dec"]="['<Super><Shift>minus']"
    ["resize-h-inc"]="['<Super><Shift>plus']"
    ["resize-w-dec"]="['<Super>minus']"
    ["resize-w-inc"]="['<Super>plus']"
    ["slurp-in"]="['']"
    ["swap-monitor-above"]="['']"
    ["swap-monitor-below"]="['']"
    ["swap-monitor-left"]="['']"
    ["swap-monitor-right"]="['']"
    ["switch-down"]="['<Super>j']"
    ["switch-down-loop"]="['']"
    ["switch-down-or-else-workspace"]="[]"
    ["switch-down-workspace"]="['']"
    ["switch-down-workspace-from-all-monitors"]="[]"
    ["switch-eighth"]="[]"
    ["switch-eleventh"]="[]"
    ["switch-fifth"]="[]"
    ["switch-first"]="['']"
    ["switch-focus-mode"]="['<Super><Shift>c']"
    ["switch-fourth"]="[]"
    ["switch-global-down"]="[]"
    ["switch-global-left"]="[]"
    ["switch-global-right"]="[]"
    ["switch-global-up"]="[]"
    ["switch-last"]="['']"
    ["switch-left"]="['<Super>h']"
    ["switch-left-loop"]="['']"
    ["switch-monitor-above"]="['']"
    ["switch-monitor-below"]="['']"
    ["switch-monitor-left"]="['']"
    ["switch-monitor-right"]="['']"
    ["switch-next"]="['']"
    ["switch-next-loop"]="[]"
    ["switch-ninth"]="[]"
    ["switch-open-window-position"]="['<Super><Shift>w']"
    ["switch-previous"]="['']"
    ["switch-previous-loop"]="[]"
    ["switch-right"]="['<Super>l']"
    ["switch-right-loop"]="['']"
    ["switch-second"]="[]"
    ["switch-seventh"]="[]"
    ["switch-sixth"]="[]"
    ["switch-tenth"]="[]"
    ["switch-third"]="[]"
    ["switch-up"]="['<Super>k']"
    ["switch-up-loop"]="['']"
    ["switch-up-or-else-workspace"]="[]"
    ["switch-up-workspace"]="['']"
    ["switch-up-workspace-from-all-monitors"]="[]"
    ["take-window"]="['']"
    ["toggle-maximize-width"]="['<Super>f']"
    ["toggle-position-bar"]="[]"
    ["toggle-scratch"]="['<Super><Ctrl>Escape']"
    ["toggle-scratch-layer"]="['<Super><Shift>Escape']"
    ["toggle-scratch-window"]="['<Super>Escape']"
    ["toggle-top-and-position-bar"]="['']"
    ["toggle-top-bar"]="[]"
