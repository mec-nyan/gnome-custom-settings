# PaperWM settings
#
#

# Show current keybindings.
# Use a subshell to avoid messing with GSETTINGS_SCHEMA_DIR (if set by the user).
_print_paperwm_keybindings() (
  local pretty=${1}

  # We need to set the schemas' directory to modify PaperWM settings.
  local schemas_dir="::$HOME/.local/share/gnome-shell/extensions/paperwm@paperwm.github.com/schemas"

  export GSETTINGS_SCHEMA_DIR="${schemas_dir}"

  local schema='org.gnome.shell.extensions.paperwm.keybindings'

  local keys=($(gsettings list-keys "${schema}"))

  printf "== Schema: %s (%d key mappings)\n" "${schema}" "${#keys[@]}"

  for key in "${keys[@]}"; do
    local kind="$(gsettings range ${schema} ${key})"
    local keybinding="$(gsettings get ${schema} ${key})"
    if [[ "${pretty}" == "-p" ]]; then
      # Show with colours (to the terminal)
      printf "    \x1b[35m(%8s)] \x1b[0m%s: \x1b[32m%s\x1b[0m\n" "${kind}" "${key}" "${keybinding}"
    elif [[ "${pretty}" == "-f" ]]; then
      # for printing to file
      printf "[\"%s\"]=\"%s\"\n" "${key}" "${keybinding}"
    else
      # default
      printf "[%s] [%s] [%s]\n" "${kind}" "${key}" "${keybinding}"
    fi
  done
)

# Clear current keybindings.
# Use a subshell to avoid messing with GSETTINGS_SCHEMA_DIR (if set by the user).
_delete_paperwm_keybindings() (
  # We need to set the schemas' directory to modify PaperWM settings.
  local schemas_dir="::$HOME/.local/share/gnome-shell/extensions/paperwm@paperwm.github.com/schemas"

  export GSETTINGS_SCHEMA_DIR="${schemas_dir}"

  local schema='org.gnome.shell.extensions.paperwm.keybindings'

  local keys=($(gsettings list-keys "${schema}"))

  local key_count=0
  local modified=0

  for key in "${keys[@]}"; do
    ((key_count++))
    local kind="$(gsettings range ${schema} ${key})"
    if [[ "${kind}" == *array* || "${kind}" == *as* ]]; then
      ((modified++))
      gsettings set "${schema}" "${key}" "[]"
      printf "Key \x1b[34m%s\x1b[0m disabled.\n" "${key}"
    else
      printf "\x1b[31mnoop\n\x1b[0m"
    fi
  done

  printf "Done! %d of %d keybindings disabled.\n" "${modified}" "${key_count}"
)

_set_paperwm_keybindings() (
